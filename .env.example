# swimzh — local dev environment. Copy to `.env` and adjust:
#   cp .env.example .env
# `apps/web/config.py` loads `.env` at startup (real exported env vars still win), so with
# a `.env` in place you can run the server without exporting anything:
#   uv run python -m apps.web.main        # (builds the UI, then serves)
#   uv run uvicorn apps.web.main:app      # (serves; assumes UI already built)
# `.env` is git-ignored; this `.env.example` is the committed, safe-to-share template.

# The single runtime source of truth — build it first with:
#   uv run python -m swimzh.cli build --db gold.sqlite
SWIMZH_GOLD_DB=gold.sqlite

# Live water-temperature feed (Stadt Zürich OGD Baditicker). Set = enable the real provider;
# unset/empty = fail-open (the /pools/{id} detail reports "live temperature not configured").
SWIMZH_BADITICKER_URL=https://www.stadt-zuerich.ch/stzh/bathdatadownload

# --- Optional (defaults shown) ---
# SWIMZH_HOST=127.0.0.1
# SWIMZH_PORT=8000
# SWIMZH_RELOAD=1        # auto-reload on code change (python -m apps.web.main). 0 to disable.
# SWIMZH_DEV_UI=0        # 1 = no-store cache on /static + register the dev /ui/gallery
