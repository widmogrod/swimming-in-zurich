# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
/build/
/dist/

# uv
.uv/

# tooling caches
.pytest_cache/
.ruff_cache/
.pyright/
.mypy_cache/

# coverage artifacts (crap.py consumes coverage.json at runtime; it's regenerated)
.coverage
coverage.json
htmlcov/

# project artifacts
*.sqlite
*.db

# provider HTTP disk cache (`.cache/swimzh/<tier>/…`) — a dev/build accelerator, never a source
# of truth and never the test-fixture store (the vcrpy cassettes stay the committed contract).
/.cache/

# TS build output (tsc emits static/js -> static/dist; a build artifact, never committed)
apps/web/static/dist/
apps/web/static/js/node_modules/
apps/web/static/js/coverage/
apps/web/static/js/.eslintcache
/data/raw/

# IDE / editor
.idea/
.vscode/
*.swp
.DS_Store

# Local dev env (copied from .env.example; never commit real .env)
.env
!.env.example

# Swift / Xcode build output
apps/ios/.build/
apps/ios/.swiftpm/
**/xcuserdata/
DerivedData/

# The iOS bundled store is the ONE committed `.sqlite`, so it is exempted from the
# blanket rule above. It is a DERIVED artifact — like `data/catalog.json` — built offline
# from the recorded cassettes, and the Swift and Xcode chains both need it on a fresh
# checkout that has no gold store and no network. Regenerate with `make ios-fixtures`.
!apps/ios/Sources/SwimZHKit/Resources/ios.sqlite

# fastlane runs in the release workflow only (see .github/workflows/release.yml). These are
# the run artefacts it drops in the working tree; the Fastfile itself IS committed.
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
.bundle/
vendor/bundle/

# See the Gemfile: a lock authored on Apple's system Ruby 2.6 resolves gems the CI
# runner's Ruby 3.3 cannot install, so the version floor is pinned in the Gemfile instead.
Gemfile.lock
