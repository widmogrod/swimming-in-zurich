# Driven by .github/workflows/release.yml only. Nothing here is meant to be run by hand
# against production — the API key it needs lives in GitHub secrets.
default_platform(:ios)

platform :ios do
  desc "Upload an already-exported IPA to App Store Connect and submit it for review"
  lane :publish do |options|
    # base64, because a PEM with real newlines does not survive a GitHub secret cleanly.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_PRIVATE_KEY"),
      is_key_content_base64: true,
      in_house: false
    )

    # skip_metadata / skip_screenshots: the listing is maintained BY HAND in App Store Connect
    # and is not in this repo. Uploading empty metadata over a real listing would wipe it, so
    # this publishes a binary against whatever listing already exists.
    #
    # submit_for_review + automatic_release: the owner asked for fully hands-off. The safety
    # net is upstream — this lane only runs after a green build of a store the client itself
    # re-validates, and only from a published GitHub Release.
    upload_to_app_store(
      api_key: api_key,
      ipa: options[:ipa],
      app_version: options[:version],
      skip_metadata: true,
      skip_screenshots: true,
      skip_binary_upload: false,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false,
      # Both are FALSE facts about this app, not conveniences: it ships no ad framework, and
      # it uses no encryption beyond the exempt HTTPS. Apple asks these on every submission
      # and a missing answer stalls the review in "Waiting for Export Compliance".
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
