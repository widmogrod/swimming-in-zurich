    "access.accompanied.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Kinder nur in Begleitung Erwachsener (für Kinder nur mit Erwachsenen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For children only when accompanied by an adult (für Kinder nur mit Erwachsenen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les enfants uniquement accompagnés d’un adulte (für Kinder nur mit Erwachsenen)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per bambini solo se accompagnati da un adulto (für Kinder nur mit Erwachsenen)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla dzieci wyłącznie pod opieką osoby dorosłej (für Kinder nur mit Erwachsenen)."
          }
        }
      }
    },
