    "detail.note.closed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bad ist an diesem Tag aus einem angegebenen Grund geschlossen — das wird nicht mit Bädern vermischt, zu denen uns schlicht Daten fehlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pool is closed for a stated reason on this day — it is not merged with pools we simply lack data for."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette piscine est fermée ce jour-là pour un motif indiqué — ce n’est pas confondu avec les piscines dont les données nous manquent simplement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa piscina è chiusa in questo giorno per un motivo dichiarato — non viene confusa con le piscine di cui semplicemente non abbiamo dati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten basen jest tego dnia zamknięty z podanego powodu — nie łączymy tego z basenami, o których po prostu brakuje nam danych."
          }
        }
      }
    },
    "detail.note.lanesUnknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Bad ist noch kein Belegungsplan veröffentlicht — die Zeiten sind erfasst, die Aufteilung in öffentliche und reservierte Bahnen aber nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No published lane plan for this pool yet — the hours are curated, but the per-lane public/reserved split isn’t."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun plan des lignes n’est encore publié pour cette piscine — les horaires sont renseignés, mais pas la répartition entre lignes publiques et réservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per questa piscina non è ancora pubblicato un piano delle corsie — gli orari sono curati, ma non la suddivisione tra corsie pubbliche e riservate."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla tego basenu nie opublikowano jeszcze planu torów — godziny są opracowane, ale podział na tory publiczne i zarezerwowane już nie."
          }
        }
      }
    },
    "detail.note.uncurated": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir kennen den Standort dieses Bads, haben aber noch keinen Zeitplan. Unbekannt ist nicht dasselbe wie geschlossen — es kann durchaus offen sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We have this pool’s location but no session timetable yet. Unknown is not the same as closed — it may well be open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous connaissons l’emplacement de cette piscine mais pas encore son horaire. Inconnu n’est pas la même chose que fermé — elle peut très bien être ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conosciamo la posizione di questa piscina ma non ancora il suo orario. Sconosciuto non è la stessa cosa che chiuso — potrebbe benissimo essere aperta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znamy lokalizację tego basenu, ale nie mamy jeszcze harmonogramu. Brak danych to nie to samo co zamknięte — może być otwarty."
          }
        }
      }
    },
