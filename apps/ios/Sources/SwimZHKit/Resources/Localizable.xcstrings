    "legend.honestyNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Banddicke ist die tatsächliche heutige Aufteilung der öffentlichen Bahnen — nicht die Auslastung, für die es noch keine Quelle gibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ribbon thickness is today’s real public-lane split — not busyness, which has no source yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’épaisseur du ruban est la répartition réelle des lignes publiques aujourd’hui — pas la fréquentation, pour laquelle il n’existe pas encore de source."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spessore del nastro è l’effettiva suddivisione odierna delle corsie pubbliche — non l’affluenza, per la quale non esiste ancora una fonte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grubość wstęgi to rzeczywisty dzisiejszy podział torów publicznych — nie obłożenie, dla którego nie ma jeszcze źródła."
          }
        }
      }
    },
