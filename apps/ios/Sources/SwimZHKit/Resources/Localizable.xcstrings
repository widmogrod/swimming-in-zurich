    "accessTypes.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regeln des einzelnen Angebots gelten immer: Was ein Bad für eine bestimmte Stunde veröffentlicht, zeigt diese App — und das sind die Kategorien, in die sie es einordnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session’s own rules always win: what a pool publishes for a particular hour is what this app shows, and these are the categories it sorts them into."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles propres à une séance priment toujours : cette app affiche ce que la piscine publie pour une heure donnée, et voici les catégories dans lesquelles elle les classe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole della singola sessione hanno sempre la precedenza: questa app mostra ciò che la piscina pubblica per una determinata ora, e queste sono le categorie in cui le classifica."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze decydują zasady samych zajęć: aplikacja pokazuje to, co basen publikuje na daną godzinę, a to są kategorie, do których je przypisuje."
          }
        }
      }
    },
