    "state.none.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier passt nichts — versuchen Sie einen grösseren Umkreis oder einen anderen Tag. Das ist nicht dasselbe wie geschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing matched here — try a wider area or a different day. Not the same as closed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne correspond ici — essayez une zone plus large ou un autre jour. Ce n’est pas la même chose que fermée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non corrisponde nulla — prova un’area più ampia o un altro giorno. Non è la stessa cosa che chiusa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic tu nie pasuje — spróbuj większego obszaru albo innego dnia. To nie to samo co zamknięte."
          }
        }
      }
    },
    "state.none.body.phone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grösseren Umkreis, anderen Tag oder weniger Filter versuchen. Das ist nicht dasselbe wie geschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a wider area, another day, or fewer filters. This is not the same as everything being closed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez une zone plus large, un autre jour ou moins de filtres. Ce n’est pas la même chose que si tout était fermé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un’area più ampia, un altro giorno o meno filtri. Non è la stessa cosa che essere tutto chiuso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj większego obszaru, innego dnia albo mniejszej liczby filtrów. To nie to samo co zamknięte."
          }
        }
      }
    },
