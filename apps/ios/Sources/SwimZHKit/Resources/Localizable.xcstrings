    "state.beyondHorizon.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir liefern Antworten bis %1$@. Das heisst nicht, dass die Bäder geschlossen sind — wir haben diesen Tag schlicht noch nicht aufgelöst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We publish answers through %1$@. This is not the same as the pools being closed — we simply have not resolved this day yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous publions des réponses jusqu’au %1$@. Ce n’est pas la même chose que des piscines fermées — nous n’avons simplement pas encore traité ce jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pubblichiamo risposte fino al %1$@. Non significa che le piscine siano chiuse — semplicemente non abbiamo ancora elaborato questo giorno."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Publikujemy odpowiedzi do %1$@. To nie oznacza, że baseny są zamknięte — po prostu nie opracowaliśmy jeszcze tego dnia."
          }
        }
      }
    },
