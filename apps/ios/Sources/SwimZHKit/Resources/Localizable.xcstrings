    "access.girls.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Mädchen — das Bad nennt keine Altersgrenze, bitte dort nachfragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Girls-only session (für Mädchen) — the pool publishes no age cutoff, so confirm with the venue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séance réservée aux filles (für Mädchen) — la piscine ne publie pas de limite d’âge, renseignez-vous sur place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessione solo per ragazze (für Mädchen) — la piscina non pubblica un limite di età: verifica con la struttura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zajęcia tylko dla dziewcząt (für Mädchen) — basen nie podaje granicy wieku, więc potwierdź w obiekcie."
          }
        }
      }
    },
