    "warning.calendar_coverage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %1$@ liegen keine Kalenderdaten vor; feiertagsabhängige Zeitpläne können ungenau sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "calendar data not available for %1$@; holiday-dependent schedules may be inaccurate"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de calendrier ne sont pas disponibles pour %1$@ ; les horaires liés aux jours fériés peuvent être inexacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati del calendario non sono disponibili per il %1$@; gli orari che dipendono dai festivi possono essere imprecisi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak danych kalendarza na %1$@; harmonogramy zależne od świąt mogą być niedokładne."
          }
        }
      }
    },
    "warning.holiday_hours_unverified": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist ein Feiertag, und diese Bäder veröffentlichen keine Feiertagszeiten; angezeigt sind ihre üblichen Wochentagszeiten, unbestätigt: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is a public holiday and these pools do not publish their holiday hours; the times shown are their usual weekday hours and are unconfirmed: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le %1$@ est un jour férié et ces piscines ne publient pas leurs horaires de jour férié ; les heures affichées sont leurs horaires habituels de semaine et ne sont pas confirmées : %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è un giorno festivo e queste piscine non pubblicano i loro orari festivi; gli orari mostrati sono quelli abituali dei giorni feriali e non sono confermati: %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to dzień świąteczny, a te baseny nie publikują swoich godzin świątecznych; pokazane godziny to ich zwykłe godziny dnia powszedniego i są niepotwierdzone: %2$@"
          }
        }
      }
    },
