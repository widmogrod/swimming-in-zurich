    "access.adults.desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffentliches Fenster nur für Erwachsene — reserviert für Gäste ab 18 Jahren (typisch für Abendschwimmen in Schulbädern)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adults-only public window — reserved for guests aged 18 and over (typical for school-pool evening swims)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créneau public réservé aux adultes de 18 ans et plus (typique des soirées en piscine scolaire)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fascia pubblica solo per adulti — riservata agli ospiti dai 18 anni in su (tipica delle serate nelle piscine scolastiche)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Publiczne okno tylko dla dorosłych — zarezerwowane dla gości od 18. roku życia (typowe dla wieczornego pływania w basenach szkolnych)."
          }
        }
      }
    },
