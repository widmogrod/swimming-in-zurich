    "state.unlisted.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben den Zeitplan dieses Bads noch nicht — es kann durchaus offen sein. Das ist nicht dasselbe wie geschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We don’t have this pool’s timetable yet — it may well be open. This is not the same as closed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas encore l’horaire de cette piscine — elle peut très bien être ouverte. Ce n’est pas la même chose que fermée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo ancora l’orario di questa piscina — potrebbe benissimo essere aperta. Non è la stessa cosa che chiusa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mamy jeszcze harmonogramu tego basenu — może być otwarty. To nie to samo co zamknięty."
          }
        }
      }
    },
