<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Lab switches, shown by the SYSTEM Settings app under SwimZH. See `Lab.swift`: each key
  is read through `@AppStorage`, so flipping one here re-renders the app live. English only,
  deliberately: these toggles exist until one variant of each is chosen, and are then deleted.
-->
<plist version="1.0">
<dict>
	<key>StringsTable</key>
	<string>Root</string>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Lab: iOS 27 Liquid Glass</string>
			<key>FooterText</key>
			<string>Experiments under review. Each switch is a proposed look; off is the previous look. Changes apply immediately.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Day strip</string>
			<key>Key</key>
			<string>lab.stripStyle</string>
			<key>DefaultValue</key>
			<string>tint</string>
			<key>Titles</key>
			<array>
				<string>Flat (previous look)</string>
				<string>Glass, morphing selection</string>
				<string>Glass, tinted selection (lens on press)</string>
				<string>Glass, system button style</string>
			</array>
			<key>Values</key>
			<array>
				<string>flat</string>
				<string>morph</string>
				<string>tint</string>
				<string>button</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Bottom bar</string>
			<key>Key</key>
			<string>lab.bottomBar</string>
			<key>DefaultValue</key>
			<string>toolbar</string>
			<key>Titles</key>
			<array>
				<string>Toolbar, list/map segments (previous look)</string>
				<string>Toolbar, one list/map toggle button</string>
				<string>Tab bar (sliding lens) + filter pill</string>
			</array>
			<key>Values</key>
			<array>
				<string>toolbar</string>
				<string>toggle</string>
				<string>tabs</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Glass map card</string>
			<key>Key</key>
			<string>lab.glassCard</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Symbol motion</string>
			<key>Key</key>
			<string>lab.symbolMotion</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Links open in</string>
			<key>Key</key>
			<string>lab.linkOpener</string>
			<key>DefaultValue</key>
			<string>safari</string>
			<key>Titles</key>
			<array>
				<string>In-app Safari, full screen</string>
				<string>In-app Safari, pull-down sheet</string>
				<string>App browser (own glass toolbar)</string>
				<string>Safari app (previous look)</string>
			</array>
			<key>Values</key>
			<array>
				<string>safari</string>
				<string>sheet</string>
				<string>web</string>
				<string>external</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Lab: performance review</string>
			<key>FooterText</key>
			<string>Three ways the app moves, to feel side by side. Data and answers are the same under every setting.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Favourite row</string>
			<key>Key</key>
			<string>lab.favouriteMove</string>
			<key>DefaultValue</key>
			<string>hold</string>
			<key>Titles</key>
			<array>
				<string>Stays put; reorders at the top (default)</string>
				<string>Slides to the front at once (previous, animated)</string>
				<string>Never reorders</string>
			</array>
			<key>Values</key>
			<array>
				<string>hold</string>
				<string>move</string>
				<string>never</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Pool map arrives</string>
			<key>Key</key>
			<string>lab.poolMapArrival</string>
			<key>DefaultValue</key>
			<string>afterPush</string>
			<key>Titles</key>
			<array>
				<string>After the push, fading in (default)</string>
				<string>With the push (previous)</string>
			</array>
			<key>Values</key>
			<array>
				<string>afterPush</string>
				<string>withPush</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Preload keyboard</string>
			<key>Key</key>
			<string>lab.keyboardWarmup</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
