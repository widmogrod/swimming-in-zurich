<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Lab switches, shown by the SYSTEM Settings app under SwimZH. See `Lab.swift`: each key is
  read through `@AppStorage`, so picking here re-renders the app live — switch, then come back
  to the app. English only, deliberately: these pickers exist until one variant is chosen, and
  are then deleted.
-->
<plist version="1.0">
<dict>
	<key>StringsTable</key>
	<string>Root</string>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Lab: wide screen (unfolded)</string>
			<key>FooterText</key>
			<string>How the app uses a wide window — an unfolded phone, an iPad, or a landscape Max. Applies only when the window is wide; a folded phone is the same under every choice. Changes apply immediately.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Wide layout</string>
			<key>Key</key>
			<string>lab.wideLayout</string>
			<key>DefaultValue</key>
			<string>stage</string>
			<key>Titles</key>
			<array>
				<string>Stage: map with a floating list</string>
				<string>Phone layout, stretched (control)</string>
			</array>
			<key>Values</key>
			<array>
				<string>stage</string>
				<string>phone</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Search and filters</string>
			<key>Key</key>
			<string>lab.wideChrome</string>
			<key>DefaultValue</key>
			<string>column</string>
			<key>Titles</key>
			<array>
				<string>In the list card's bar, filters as a popover</string>
				<string>System tab bar at the top (control)</string>
			</array>
			<key>Values</key>
			<array>
				<string>column</string>
				<string>tabs</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Opening a pool zooms to</string>
			<key>Key</key>
			<string>lab.wideFocus</string>
			<key>DefaultValue</key>
			<string>neighbourhood</string>
			<key>Titles</key>
			<array>
				<string>The neighbourhood (1.5 km, other pins stay)</string>
				<string>The pool (700 m, like the phone)</string>
			</array>
			<key>Values</key>
			<array>
				<string>neighbourhood</string>
				<string>pool</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
